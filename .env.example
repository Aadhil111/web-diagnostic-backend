# Copy to .env and fill in:  cp .env.example .env

# Your domain name (an A record pointing at the EC2 Elastic IP). The website and the API both live here.
DOMAIN=your-domain.com

# Email Let's Encrypt can reach for certificate notices.
ACME_EMAIL=you@example.com

# Chrome extension id (32 lowercase letters a-p): the id the Chrome Web Store assigns (developer dashboard)
# or an unpacked extension's id (chrome://extensions). Leave empty until you have one: the website works without it.
# Several ids can be given separated by commas.
EXTENSION_ID=

# Optional: where the website repository's public/ folder is on this server (default: next to this repository).
# WEBSITE_DIR=/opt/web-diagnostic/web-diagnostic-website/public
